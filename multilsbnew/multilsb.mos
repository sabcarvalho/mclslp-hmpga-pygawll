model "MULTI-LOTSB"	

uses "mmxprs"		
uses "mmsystem"

! This is the mosel file to be used with all the instances of four test sets.
! The demand data for each different instance is in the separate folder with
! that particular instance's name, and the general data for every set is in 
! the main folder of that data set.
! 4 problem sets, each set containing 30 instances
! This is the basic IP model.
! Date: 29.August.2006
! Revised: 21.April.2010

!The following can be used to automate this file (can be input from a 
!generic data file which is generated by a batch file:
!Otherwise, manually update these:
TestSet:="SET3"
Instance:="01"

declarations
NT: integer		!number of periods - tobe initialized from the data file
end-declarations

initializations from TestSet+'\\periods.txt'
NT
end-initializations

writeln ("NT ... ",NT)

declarations
NI=78			!number of items
NF=17			!number of families
nbendp=6		!number of end items

item= 1..NI
enditem=1..nbendp
period= 1..NT
fam= 1..NF 
mc={1,2,8,9,10,17}

bSolutionFound : boolean
bUseTimeConstraintsOnSolves = true

cost: mpvar
costinv: mpvar
costb: mpvar
x: array(period,item) of mpvar					!production amount
y: array(period,item) of mpvar					!setup variable for each item
w: array(period,fam) of mpvar					!setup variable for each family
s: array(period,item) of mpvar					!stock variable
b: array(period,enditem) of mpvar				!backlog variable

echs: array (period,item) of mpvar				!echelon stock
echd: array (period,item) of real				!echelon demand

h: array(item) of real			!holding cost for each item (used only for calculations)

demand: array(period,enditem) of real		!demand
totdem: array(enditem) of real		!total demand for t,..,NT
avgdem: array(item) of real				!mean primary demand
netdem: array(item) of real				!mean net demand
r: array(item,item) of real			!number items required to produce the successor
ech: array(item,enditem) of real	!number items required to produce the enditem
RU: real						!Resource utilization
RUT: integer					!RU type (slightly different ways for different sets)
BC: real						!Backorder cost coefficient
a: array(item,mc) of real		!production coefficient for mc/item pairs
c: array(item,fam) of integer	!1 if item i is in family f
v: array(fam,mc) of real		!setup time for mc/family pairs
e: array(item) of real			!marginal holding costs for each product
s0: array(item) of real			!beginning inventory for each item
sN: array(item) of real			!ending inventory for each item
cap: array(mc) of real			!available capacity for each mc

int1: integer			!integer values used for data reading purposes
int2: integer

end-declarations

setparam("XPRS_CPUTIME",1)

!=========================================================
! The following main block is used to get input data. ====
!=========================================================

starttime := gettime 
! Read the demand amounts from the file:
fopen(TestSet+"\\"+Instance+"\\demand.txt",F_INPUT)
forall (t in period) do
	forall (i in 1..(nbendp-1)) read(demand(t,i),';')
	readln(demand(t,nbendp))
end-do
fclose(F_INPUT)

!Calculate average demand:
forall (i in enditem) avgdem(i):= (sum(t in period) demand(t,i))/NT
forall (i in nbendp+1..NI) avgdem(i):= 0

! First assign all the parameters as 0:
forall (i in item,j in item) r(i,j):=0
forall (k in mc,i in item) a(i,k):=0
forall (i in item, f in fam) c(i,f):=0
forall (f in fam, k in mc) v(f,k):=0 

! Read the main input file:

fopen(TestSet+"\\multilsb_data.txt",F_INPUT)
readln("RU: ",RU)
readln("RUT: ",RUT)
readln("BC: ",BC)
readln
forall (i in item) do
	readln(i,";",int1,";",a(i,int1))
end-do

readln
forall (i in 1..36) do
	readln(int1,";",int2,";",c(int1,int2))
end-do

readln
forall (i in 1..11) do
	readln(int1,";",int2,";",v(int1,int2))
end-do

readln
forall (i in nbendp+1..NI) do
	readln(i,";",int1)
	r(i,int1):=1
end-do

readln
forall (i in item) do
	readln(i,";",e(i))
end-do

fclose(F_INPUT)
	
!============================================================================
! The following main block consists of the calculation of the necessary =====
! parameters for the model. =================================================
!============================================================================

! Calculate the echelon values for each item and enditem pair:
forall(i in item,j in enditem) ech(i,j):=0
forall (i in (nbendp+1)..NI) do
   forall (j in enditem)
      ech(i,j):= r(i,j)
   forall (j in enditem,k in (nbendp+1)..i)
      ech(i,j):= ech(i,j) + r(i,k)*ech(k,j)
end-do

! Calculate mean net demand:
forall (i in enditem) netdem(i):= avgdem(i)
forall (i in nbendp+1..NI) netdem(i):= avgdem(i)+ sum(j in 1..(i-1)) r(i,j)*netdem(j)

! Calculate available capacity on each machine:
forall(k in mc) do
if (RUT=1) then
	cap(k):= ((sum(i in item) (a(i,k)*netdem(i))) + sum(f in fam) v(f,k))/RU
else	
	cap(k):= (sum(i in item) (a(i,k)*netdem(i))) + sum(f in fam) v(f,k)/RU
end-if
	writeln("cap at ",k,": ",cap(k))
end-do

! Holding cost:
h(NI):= e(NI)
int1:= NI
repeat
   int1:= int1-1
   h(int1):= e(int1) + sum(j in (int1+1)..NI) r(j,int1)*h(j)
until (int1<=1)

! Calculate total demand:
forall (i in enditem) totdem(i):= sum(t in period) demand(t,i)

!==================================================================================
! The following main block is the collection of the constraints and the objective =
! function of the model. ==========================================================
!==================================================================================

! total cost function:
costinv= sum(t1 in period,j in item) (h(j)*s(t1,j))
costb= sum(t1 in period,j in enditem) (BC*h(j)*b(t1,j))
cost= costinv+costb

! Flow balance for end items:
forall (i in enditem)
bal1(i):= x(1,i) + b(1,i) - s(1,i) = demand(1,i)
forall (t in 2..NT,i in enditem)
bal2(t,i):= x(t,i) + b(t,i) - b(t-1,i) + s(t-1,i) - s(t,i) = demand(t,i)

! Flow balance for non-end items:
forall (i in (nbendp+1..NI))
bal3(i):= x(1,i) - s(1,i) = sum(j in 1..(i-1)) r(i,j)* x(1,j)
forall (t in 2..NT,i in (nbendp+1..NI))
bal4(t,i):= x(t,i) + s(t-1,i) - s(t,i) = sum(j in 1..(i-1)) r(i,j)* x(t,j)

! Production variable-binary variable relations:
forall (t in period, i in enditem)
rel1(t,i):= x(t,i) <= totdem(i)*y(t,i) + if(t>=2, b(t-1,i),0)
forall (t in period, i in (nbendp+1..NI))
rel2(t,i):= x(t,i) <= sum(j in enditem) (y(t,i)*ech(i,j)*totdem(j) + if(t>=2,ech(i,j)*b(t-1,j),0))

! Relation between binary variables:
forall (i in item, t in period) do
	forall (f in fam|c(i,f)=1) y(t,i) <= w(t,f)
end-do

! Capacity constraint:
forall (t in period,k in mc)
mccap(t,k):= (sum(i in item) (a(i,k)*x(t,i))) + (sum(f in fam) (v(f,k)*w(t,f))) <= cap(k)

forall (t in period, i in item, f in fam, k in mc|c(i,f)=1) do
	if (a(i,k)>0) then
		rel3(t,i,f,k):= a(i,k)*x(t,i) <= (cap(k) - v(f,k))*y(t,i)!w(t,f)
	end-if
end-do

! Setup variables to be binary:
forall (t in period, i in item) 
y(t,i) is_binary
forall (t in period, f in fam)
w(t,f) is_binary

! Prevent the Gomory cuts for lot-sizing problem:
setparam("XPRS_GOMCUTS",0)

! Solve the problem
setparam("XPRS_VERBOSE", true)

! Set time limit to 30 minutes for test (change/remove if you like):
setparam("XPRS_MAXTIME", 1800)

! Output is printed into a file:
fopen(TestSet+"_"+Instance+"_results.dat",F_OUTPUT)
minimize(cost)
writeln('The solution:')
writeln('=============')
writeln('Cost:', getobjval)
fclose(F_OUTPUT)

end-model
